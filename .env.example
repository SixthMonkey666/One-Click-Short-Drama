# ============================================================
# Storyboard Flow 配置文件
# 复制此文件为 .env 后根据需要修改
# ============================================================

# --- Provider 选择 ---
# 可选值：
# LLM_PROVIDER=qwen3_vl | openai_compatible | custom | mock
# IMAGE_PROVIDER=flux | openai_compatible | custom | mock
# 生产环境缺少模型或依赖时直接报错，不会静默降级为 Mock。
LLM_PROVIDER=qwen3_vl
IMAGE_PROVIDER=flux
VIDEO_PROVIDER=ffmpeg

# --- 评测 Judge Provider ---
JUDGE_PROVIDER=qwen3_vl
JUDGE_MAX_RETRIES=2
JUDGE_PROMPT_VERSION=v1.0
AGENT_MAX_STORYBOARD_RETRIES=2
AGENT_MAX_ASSET_RETRIES=2
AGENT_MAX_VIDEO_PROMPT_RETRIES=2
AGENT_STORYBOARD_PASS_SCORE=3.5

# --- 模型路径 ---
# 默认读取用户目录 ~/ai_models/
# 如需自定义路径，取消注释并修改：
# LOCAL_QWEN_MODEL_DIR=/path/to/Qwen3-VL-4B-Instruct
# LOCAL_FLUX_MODEL_DIR=/path/to/FLUX.2-klein-4B

# --- OpenAI-compatible 文本模型 ---
# 同一套配置可连接本地 Ollama / vLLM / LM Studio / LocalAI，或兼容的云端 API。
# 本地示例（Ollama）：
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_LLM_MODEL=qwen3:8b
# OPENAI_COMPATIBLE_LLM_API_KEY=
#
# 云端示例：替换为服务商提供的 Base URL、模型 ID 和密钥。
# OPENAI_COMPATIBLE_LLM_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_LLM_MODEL=provider-model-id
# OPENAI_COMPATIBLE_LLM_API_KEY=replace-me
OPENAI_COMPATIBLE_LLM_TIMEOUT_SECONDS=300

# --- OpenAI-compatible 图片模型 ---
# 服务需实现 POST /v1/images/generations。
# 若要使用角色参考图保持一致性，还需实现 POST /v1/images/edits。
# IMAGE_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_IMAGE_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_COMPATIBLE_IMAGE_MODEL=local-image-model
# OPENAI_COMPATIBLE_IMAGE_API_KEY=
OPENAI_COMPATIBLE_IMAGE_TIMEOUT_SECONDS=600
OPENAI_COMPATIBLE_IMAGE_RESPONSE_FORMAT=b64_json
OPENAI_COMPATIBLE_IMAGE_MAX_DOWNLOAD_MB=30

# 若文本与图片使用同一个服务和密钥，可只设置公共密钥作为回退：
OPENAI_COMPATIBLE_API_KEY=

# --- 自定义 Python Provider 插件 ---
# 用于直接接入任意本地推理代码或非 OpenAI-compatible API。
# 类必须继承 app.providers.base 中对应的抽象基类。
# LLM_PROVIDER=custom
# CUSTOM_LLM_PROVIDER_CLASS=my_backends.llm:MyLLMProvider
# IMAGE_PROVIDER=custom
# CUSTOM_IMAGE_PROVIDER_CLASS=my_backends.image:MyImageProvider

# --- 加载选项 ---
# Qwen 8bit 量化：auto（≤20GB 内存自动启用）/ true / false
QWEN_LOAD_IN_8BIT=auto

# --- MPS 与推理内存 ---
PYTORCH_ENABLE_MPS_FALLBACK=1
PYTORCH_MPS_HIGH_WATERMARK_RATIO=1.0
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.9
QWEN_MIN_AVAILABLE_GB=3.0
QWEN_JUDGE_MIN_AVAILABLE_GB=4.0
# 自动机评会先把每张视觉输入缩放到安全像素预算，降低视觉编码峰值。
QWEN_JUDGE_MAX_PIXELS=147456
QWEN_JUDGE_MIN_PIXELS=50176
QWEN_JUDGE_MAX_INPUT_IMAGES=3
QWEN_JUDGE_CPU_FALLBACK=true
QWEN_JUDGE_RELEASE_EACH_ITEM=true
FLUX_MIN_AVAILABLE_GB=4.0
# MPS 默认按 text_encoder → transformer → VAE 分阶段搬运，画质不变但更省显存。
# model 较快；若仍 OOM 会按 FLUX_MPS_OOM_RETRIES 自动改用更慢的 sequential。
FLUX_MPS_OFFLOAD_MODE=model
FLUX_MPS_OOM_RETRIES=1
FLUX_ENABLE_VAE_TILING=true
MODEL_QUEUE_WAIT_SECONDS=2.0
MODEL_MEMORY_POLL_SECONDS=2.0
MODEL_STREAM_TIMEOUT_SECONDS=300
MODEL_THREAD_JOIN_TIMEOUT_SECONDS=5
MODEL_CLEANUP_DELAY_SECONDS=0.2

# --- 模型生成参数 ---
QWEN_DEFAULT_MAX_NEW_TOKENS=800
QWEN_ANALYSIS_MAX_NEW_TOKENS=2000
QWEN_IDEA_MAX_NEW_TOKENS=220
QWEN_IDEA_TEMPERATURE=0.95
QWEN_IDEA_TOP_P=0.92
QWEN_CHARACTER_MAX_NEW_TOKENS=600
QWEN_VIDEO_PROMPT_MAX_NEW_TOKENS=1500
QWEN_JUDGE_MAX_NEW_TOKENS=1024
FLUX_GUIDANCE_SCALE=1.0
FLUX_INFERENCE_STEPS=4
# 每张关键帧最多加载的角色身份参考图数量；数值越大一致性更强，但内存占用更高。
FLUX_MAX_REFERENCE_IMAGES=2
JUDGE_MAX_VIDEO_FRAMES=6
GENERATED_IMAGE_MIN_BYTES=500
ELO_INITIAL_RATING=1000
ELO_K_FACTOR=32

# --- 数据与分辨率 ---
APP_PORT=8503
APP_DATA_DIR=data
DEFAULT_IMAGE_RESOLUTION=768x432 (快速预览)

# --- 智能创意热点（关闭后完全离线）---
HOT_TOPIC_SEARCH_ENABLED=true
HOT_TOPIC_FETCH_TIMEOUT_SECONDS=5
HOT_TOPIC_CACHE_TTL_SECONDS=300

# --- Python 包路径（通常无需修改）---
# LOCAL_PYTHON_SITE_PACKAGES=/path/to/python3.12/site-packages
# LOCAL_SYSTEM_SITE_PACKAGES=/Library/Frameworks/Python.framework/Versions/3.12/lib/python3.12/site-packages

# --- 可选：Langfuse 追踪（需自行启动 Langfuse 服务）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=local
